{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=BmsDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "DEV-ONLY-change-this-secret-key-before-deploying-1234567890",
    "Issuer": "BMS.API",
    "Audience": "BMS.Client",
    "ExpiryMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Building": {
    "TimeZone": "Africa/Addis_Ababa"
  },
  "Storage": {
    "RootPath": "uploads"
  },
  "DailyJobs": {
    "Enabled": true,
    "StartupDelaySeconds": 20
  },
  "Swagger": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
